# Local registry (modules/) first, then the Bazel Central Registry
common --registry=file:///%workspace%/
common --registry=https://bcr.bazel.build
common --lockfile_mode=refresh

# Toolchain properties
common --repo_env=BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=1
common --repo_env=ANDROID_HOME=
common --incompatible_strict_action_env
common --incompatible_enable_cc_toolchain_resolution
common --@llvm//config:experimental_stub_libgcc_s=False
common --features=system_include_paths
common --experimental_platform_in_output_dir
common --macos_minimum_os=14.0

# CUDA is compiled by the hermetic @llvm Clang (not nvcc), using the
# hash-pinned redistributables from MODULE.bazel for headers, libdevice and
# ptxas/fatbinary.
common --repo_env=CUDA_COMPILER_USE_CC_TOOLCHAIN=true
common --@rules_cuda//cuda:compiler=clang

# The CUDA headers reject libc++ on x86 (crt/host_defines.h) unless this is
# defined; our whole stack is Clang + libc++, so there is no ABI mix to guard
# against.
common --@rules_cuda//cuda:copts=-D_ALLOW_UNSUPPORTED_LIBCPP

# Clang detects the CUDA version from <cuda-path>/include/cuda.h, which the
# nvcc redistributable that rules_cuda passes as --cuda-path does not have
# (cuda.h is in cudart). Clang then warns, assumes the newest CUDA it knows and
# emits that release's PTX ISA, which ptxas 12.8 rejects. Pin CUDA 12.8's PTX
# ISA (8.7); update it with the CUDA version in MODULE.bazel.
common --@rules_cuda//cuda:copts=--cuda-feature=+ptx87
common --@rules_cuda//cuda:copts=-Wno-unknown-cuda-version

# GPU architectures that cuda_library() targets are compiled for: cubins for
# Volta (V100), Turing (T4), Ampere (A100, RTX 30xx), Ada (RTX 40xx, L4) and
# Hopper (H100), plus compute_90 PTX for newer GPUs to JIT. For quicker local
# builds, override it in user.bazelrc with just your GPU's (e.g. sm_89).
common --@rules_cuda//cuda:archs=sm_70;sm_75;sm_80;sm_86;sm_89;sm_90;compute_90

# Third-party (non-LibTorch) dependencies -- glog, gflags, fmt, cpuinfo, the
# CUDA redistributables, ... -- are not ours to fix, and their warnings bury
# LibTorch's. Silence them so a LibTorch warning stands out. The leading .*
# also matches generated sources (bazel-out/<cfg>/bin/external/<repo>/...).
common --per_file_copt=.*external/(?!libtorch)[^/]+/.*@-w
common --host_per_file_copt=.*external/(?!libtorch)[^/]+/.*@-w

# Mirrors for flaky upstream download hosts (BCR modules we cannot annotate).
common --downloader_config=bazel_downloader.cfg

# Lets Bazel auto-apply the `linux` / `macos` / `windows` configs below.
common --enable_platform_specific_config

# Native Linux builds target glibc 2.34 on the host's CPU (see
# platforms/BUILD.bazel). macOS and Windows need no pin: Bazel's auto-detected
# @platforms//host already resolves to the right @llvm toolchain there. To
# cross-compile, pass an explicit --platforms=@llvm//platforms:<os>_<arch>[...]
# (see .github/workflows/pull_request.yaml); it overrides this.
build:linux --platforms=//platforms:linux

# Pin the action environment that --incompatible_strict_action_env produces.
# Bazel 10 changed its defaults (LC_CTYPE=C.UTF-8 on all OSes, plus
# PATH=/bin:/usr/bin:/sbin:/usr/sbin vs. /bin:/usr/bin:/usr/local/bin on Unix
# in Bazel 9). The environment is part of every action's cache key, so without
# this pin the 9.x and last_rc CI jobs cannot share a disk cache. Exec-config
# (tool) actions take --host_action_env, so pin both.
common --action_env=LC_CTYPE=C.UTF-8
common --host_action_env=LC_CTYPE=C.UTF-8
common:linux --action_env=PATH=/bin:/usr/bin:/usr/local/bin
common:linux --host_action_env=PATH=/bin:/usr/bin:/usr/local/bin
common:macos --action_env=PATH=/bin:/usr/bin:/usr/local/bin
common:macos --host_action_env=PATH=/bin:/usr/bin:/usr/local/bin

# Windows' CreateProcessW caps command lines at 32767 chars; route all compiler
# args via @params files on Windows. The feature is defined by the patched
# @llvm toolchain (patches/llvm/windows_compiler_param_file.patch).
build:windows --features=compiler_param_file

# AMD GPUs (ROCm) instead of NVIDIA GPUs (CUDA), e.g. `bazel test
# --config=rocm //...`. --@libtorch//:rocm_archs selects the GPUs that device
# code is compiled for.
common:rocm --@libtorch//:gpu=rocm

# Intel GPUs (XPU) instead of NVIDIA GPUs (CUDA).
common:xpu --@libtorch//:gpu=xpu

# Build every target of this workspace and of every local registry module
# (see libtorch.txt), e.g. `bazel build --config=libtorch`.
build:libtorch --target_pattern_file=libtorch.txt

# CI defaults (see .github/workflows/pull_request.yaml)
common:ci --announce_rc
common:ci --show_timestamps
common:ci --http_timeout_scaling=3
common:ci --http_connector_attempts=12
common:ci --experimental_repository_downloader_retries=10
build:ci --verbose_failures
test:ci --test_output=errors

# Address sanitizer
common:asan --strip=never
common:asan --@llvm//config:asan
common:asan --copt -O0
common:asan --copt -g
common:asan --copt -fno-omit-frame-pointer
test:asan --test_tag_filters=-noasan

# Memory sanitizer
common:msan --strip=never
common:msan --@llvm//config:msan
common:msan --copt -O0
common:msan --copt -g
common:msan --copt -fno-omit-frame-pointer
test:msan --test_tag_filters=-nomsan

# Thread sanitizer
common:tsan --strip=never
common:tsan --@llvm//config:tsan
common:tsan --copt -O0
common:tsan --copt -g
common:tsan --copt -fno-omit-frame-pointer
test:tsan --test_tag_filters=-notsan

# Undefined Behavior sanitizer
common:ubsan --strip=never
common:ubsan --@llvm//config:ubsan
common:ubsan --copt -O0
common:ubsan --copt -g
common:ubsan --copt -fno-omit-frame-pointer
test:ubsan --test_tag_filters=-noubsan

# Machine-local settings (e.g. --jobs to bound memory use), not checked in.
try-import %workspace%/user.bazelrc
