load("@rules_cc//cc:cc_test.bzl", "cc_test")

cc_test(
    name = "accelerator_hooks_test",
    srcs = ["accelerator_hooks_test.cc"],
    copts = ["-std=gnu++20"],
    # With MPS or XPU built in, their hooks are registered (MPS reports a
    # device on Apple silicon; XPUHooks::hasXPU() is unconditionally true when
    # torch_xpu is linked), so the test only expects the default stub without
    # them.
    local_defines = select({
        "@libtorch//:mps_enabled": ["TEST_MPS_ENABLED"],
        "//conditions:default": [],
    }) + select({
        "@libtorch//:xpu_enabled": ["TEST_XPU_ENABLED"],
        "//conditions:default": [],
    }),
    deps = [
        "//tests/common:check",
        "@libtorch//:torch",
    ],
)
