load("@rules_cc//cc:cc_test.bzl", "cc_test")

cc_test(
    name = "accelerator_hooks_test",
    srcs = ["accelerator_hooks_test.cc"],
    copts = ["-std=gnu++20"],
    # With MPS built in, its hooks are registered (and report a device on
    # Apple silicon), so the test only expects the default stub without it.
    local_defines = select({
        "@libtorch//:mps_enabled": ["TEST_MPS_ENABLED"],
        "//conditions:default": [],
    }),
    deps = [
        "//tests/common:check",
        "@libtorch//:torch",
    ],
)
