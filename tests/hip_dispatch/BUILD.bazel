load("@rules_cc//cc:cc_test.bzl", "cc_test")

# Only where @libtorch//:torch includes torch_hip (--config=rocm); runs
# everywhere it builds, with or without an AMD GPU and ROCm.
cc_test(
    name = "hip_dispatch_test",
    srcs = ["hip_dispatch_test.cc"],
    copts = ["-std=gnu++20"],
    # Runs on this machine's GPU (if any), never on a remote executor.
    tags = ["no-remote-exec"],
    target_compatible_with = select({
        "@libtorch//:rocm_enabled": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//tests/common:check",
        "@libtorch//:torch",
    ],
)
