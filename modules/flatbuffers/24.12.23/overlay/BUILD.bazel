# Replaces upstream's root BUILD.bazel, whose flatc, gRPC, Go, Swift and
# TypeScript targets need dependencies this module does not declare. Only the
# header-only C++ runtime is provided, which is what code generated by flatc
# (e.g. PyTorch's mobile_bytecode_generated.h) needs.
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
    license_text = "LICENSE",
)

exports_files(["LICENSE"])

# The C++ runtime headers (everything but the flatc compiler's).
cc_library(
    name = "runtime_cc",
    hdrs = glob(
        ["include/flatbuffers/*.h"],
        exclude = [
            "include/flatbuffers/code_generator.h",
            "include/flatbuffers/code_generators.h",
            "include/flatbuffers/file_manager.h",
            "include/flatbuffers/flatc.h",
            "include/flatbuffers/idl.h",
            "include/flatbuffers/registry.h",
        ],
    ),
    strip_include_prefix = "/include",
)

alias(
    name = "flatbuffers",
    actual = ":runtime_cc",
)
